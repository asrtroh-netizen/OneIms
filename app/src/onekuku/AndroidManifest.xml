<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 内嵌 ADB mDNS 发现配对/连接端口 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- 旧独立桥包探测（内循环主路径不依赖其已安装） -->
    <queries>
        <package android:name="com.oneims.bridge" />
    </queries>

    <application>
        <!-- OneBridge：接收 shell 进程投递的 binder -->
        <provider
            android:name=".core.privilege.BridgeBinderProvider"
            android:authorities="${applicationId}.onebridge"
            android:exported="true"
            android:multiprocess="false"
            tools:ignore="ExportedContentProvider" />

        <!-- OneKuku 通道常驻保活（激活成功后顶在后台，Wi‑Fi 下静默重连） -->
        <service
            android:name=".core.OneKukuResidentService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keep OneKuku privilege channel resident and silently reconnect on Wi-Fi" />
        </service>

        <!-- 对齐 V15：FGS 扛住六位码配对通知，减轻一加/小米等清普通 ongoing -->
        <service
            android:name=".core.OneKukuPairingHostService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Host wireless ADB pairing code notification until channel activates" />
        </service>

        <!-- 通知栏 RemoteInput 提交无线调试六位码 -->
        <receiver
            android:name=".core.WirelessPairingCodeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.oneims.app.action.SUBMIT_WIRELESS_PAIRING_CODE" />
            </intent-filter>
        </receiver>

        <!-- 对齐 V15：解锁后 0/5/15s 续跑开机激活（默认禁用，BootReceiver 武装） -->
        <receiver
            android:name=".core.OneKukuUserPresentRestartReceiver"
            android:enabled="false"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
        </receiver>

        <!-- 对齐 V15 Watchdog：binder 死后限次静默重拉 -->
        <service
            android:name=".core.OneKukuWatchdogService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Watch OneBridge binder and silently restart via wireless ADB" />
        </service>

        <!-- 对齐 V15：从系统设置通知自动抓六位码（需用户开启通知使用权） -->
        <service
            android:name=".core.OneKukuPairingCodeListener"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
