<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- IMS 配置偏好与设备状态不应迁移到另一台设备，避免跨机型误应用。 -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
